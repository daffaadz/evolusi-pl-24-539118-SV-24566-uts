        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "container_memory_usage_bytes{name=~\"laravel_.*|prometheus|grafana|cadvisor|node-exporter\"}",
          "legendFormat": "{{name}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
